<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (Glow up effect) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <!-- Brighter, more saturated background when tapped -->
            <solid android:color="#40E8647A" />
            <corners android:radius="16dp" />
            <!-- Solid bright border to emphasize the glow -->
            <stroke android:width="2dp" android:color="#E8647A" />
        </shape>
    </item>
    
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AE8647A" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#40E8647A" />
        </shape>
    </item>
</selector>
