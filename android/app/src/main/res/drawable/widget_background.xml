<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism background: semi-transparent white with frosted border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted glass backdrop: slight rose tint at ~78% opacity -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C8FFF8F8" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Glass edge: thin bright stroke on top -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#80E8647A" />
        </shape>
    </item>
</layer-list>
