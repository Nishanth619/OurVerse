<?xml version="1.0" encoding="utf-8"?>
<!--
    closer_widget.xml
    ─────────────────────────────────────────────────────────────────────────────
    Glassmorphism Home Screen Widget layout.

    QUESTION mode:
      Shows pill label "TODAY'S QUESTION" + the question text.

    MOOD mode:
      Shows pill label "TODAY'S MOOD" + two emoji bubbles:
        • My mood (set inside the app)
        • Partner's mood (synced from Firestore)
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:clipChildren="false">

    <!-- ── Label pill ──────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY'S QUESTION"
        android:textSize="9sp"
        android:textColor="#E8647A"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:background="@drawable/widget_label_bg"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <!-- ── QUESTION mode: question text ──────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Closer to see today's question"
        android:textSize="14sp"
        android:textColor="#2A1020"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.35"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_below="@id/widget_label"
        android:layout_marginTop="8dp"
        android:layout_above="@id/widget_footer"
        android:layout_marginBottom="4dp"
        android:gravity="top"
        android:visibility="visible" />

    <!-- ── MOOD mode: emoji row ───────────────────────────────────────────── -->
    <!--
        Two bubbles side-by-side:
          Left  = MY mood (what I selected inside the app)
          Right = PARTNER mood (what they selected, synced from Firestore)
    -->
    <LinearLayout
        android:id="@+id/widget_mood_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@id/widget_label"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <!-- My mood bubble -->
        <LinearLayout
            android:id="@+id/widget_my_mood_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_emoji_bg"
            android:padding="8dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/widget_my_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😊"
                android:textSize="32sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/widget_my_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Me"
                android:textSize="10sp"
                android:textColor="#8B5E6A"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Heart divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💞"
            android:textSize="18sp"
            android:layout_marginHorizontal="4dp" />

        <!-- Partner mood bubble -->
        <LinearLayout
            android:id="@+id/widget_partner_mood_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_emoji_bg"
            android:padding="8dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/widget_partner_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳"
                android:textSize="32sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/widget_partner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partner"
                android:textSize="10sp"
                android:textColor="#8B5E6A"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── FLASH mode: photo block ────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/widget_flash_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_label"
        android:layout_marginTop="8dp"
        android:layout_above="@id/widget_footer"
        android:layout_marginBottom="4dp"
        android:visibility="gone">
        
        <ImageView
            android:id="@+id/widget_flash_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_emoji_bg"
            android:clipToOutline="true" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸 Partner's Flash"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#88000000"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp" />
    </FrameLayout>

    <!-- ── Footer branding ─────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💞 Closer"
        android:textSize="10sp"
        android:textColor="#8B5E6A"
        android:fontFamily="sans-serif"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true" />

</RelativeLayout>
